    <!-- Tutor Personas -->
    <string name="persona_friendly_buddy_title">Friendly Buddy</string>
    <string name="persona_friendly_buddy_desc">Relaxed, supportive friend for casual conversation and free topics.</string>
    <string name="persona_strict_teacher_title">Strict Teacher</string>
    <string name="persona_strict_teacher_desc">Academic, demanding tutor focused on accuracy and rules.</string>
    <string name="persona_business_coach_title">Business Coach</string>
    <string name="persona_business_coach_desc">Business English, professional vocabulary, negotiations and presentations.</string>
    <string name="persona_chatty_native_title">Chatty Native</string>
    <string name="persona_chatty_native_desc">Fast natural native speech, modern slang, idioms and phrasal verbs.</string>
    <string name="persona_kids_tutor_title">Kids Tutor</string>
    <string name="persona_kids_tutor_desc">Simple words, slow pace, plenty of praise and playful examples.</string>

    <!-- Strictness Levels -->
    <string name="strictness_level_0_title">Flow</string>
    <string name="strictness_level_0_desc">Does not correct aloud at all, all errors collected in post-lesson review.</string>
    <string name="strictness_level_1_title">Gentle</string>
    <string name="strictness_level_1_desc">Subtle recast: repeats your thought correctly without emphasizing mistakes.</string>
    <string name="strictness_level_2_title">Balanced</string>
    <string name="strictness_level_2_desc">Provides one main correction at the end of response and continues conversation.</string>
    <string name="strictness_level_3_title">Strict</string>
    <string name="strictness_level_3_desc">Corrects all noticeable errors and asks you to repeat the correct version.</string>
    <string name="strictness_level_4_title">Drill</string>
    <string name="strictness_level_4_desc">Interrupts immediately, insists on exact repetition including phonemes and intonation.</string>

